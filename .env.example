# 本地 AI 协作工作台 · 环境变量示例
# 用法：复制为 .env 后按需修改（.env 已被 .gitignore 排除，不会提交）
# 所有项都有默认值，不配置也能直接 ./run.sh 跑起来（外部服务回退为内置本地实现）

# ---------- 服务与数据 ----------
# 数据根目录（SQLite 与项目目录都在其下的 data/）
WORKBENCH_HOME=
# 后端绑定地址与端口（0.0.0.0 便于手机在同一局域网访问）
WORKBENCH_HOST=0.0.0.0
WORKBENCH_PORT=8080
# 前端访问后端的地址
WORKBENCH_API=http://127.0.0.1:8080
# 可选访问密码，空表示不校验
WORKBENCH_PASSWORD=

# ---------- 进度上报 ----------
# 进度节流间隔（毫秒），默认 500ms，避免前端频繁重绘
PROGRESS_THROTTLE_MS=500

# ---------- 协调员本地模型（oMLX / OpenAI 兼容） ----------
# 留空则回退为内置规则引擎（仍会拆解任务、产出真实文件）
OMLX_BASE_URL=
OMLX_API_KEY=
OMLX_MODEL=local-model
LLM_TIMEOUT=60

# ---------- 上下文与分层记忆 ----------
# 估算 token 超过该值触发压缩
CONTEXT_MAX_TOKENS=3000
# 始终保留最近 N 轮原文
CONTEXT_KEEP_TURNS=6
# 滚动摘要字数上限
CONTEXT_SUMMARY_MAX_CHARS=600
# 长期项目档案字数上限
CONTEXT_PROFILE_MAX_CHARS=800
# 每积累 N 轮新对话刷新一次长期档案
CONTEXT_PROFILE_REFRESH_TURNS=4
# 稳定前缀（system + 档案 + 摘要），便于推理服务命中前缀 KV 缓存
CONTEXT_STABLE_PREFIX=1

# ---------- Agent 连接器 ----------
# Workbuddy：HTTP 地址 或 本地命令行
WORKBUDDY_URL=
WORKBUDDY_CMD=
# 豆包
DOUBAO_BASE_URL=
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seed-1-6
# Trae
TRAE_URL=
